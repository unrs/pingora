{
  "extends": "@1stg/tsconfig/nodenext",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@pingora/*": [
        "./packages/*/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "vitest.config.mts",
    "scripts/**/*.mts",
    "bench/**/*.mts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "target"
  ]
}
