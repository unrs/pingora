{
  "extends": "@1stg/tsconfig/nodenext",
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tsdown.config.mts",
    "vitest.config.mts",
    "scripts/**/*.mts",
    "bench/**/*.ts",
    "packages/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "target"
  ]
}
