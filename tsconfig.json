{
  "extends": "@1stg/tsconfig/nodenext",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "tsdown.config.mts",
    "vitest.config.mts",
    "scripts/**/*.mts",
    "bench/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "target",
    "bench/native/pingora-server.ts",
    "bench/proxy.bench.ts"
  ]
}
