{
  "name": "@pingora/http-server",
  "version": "0.2.0",
  "description": "Direct HTTP server facade for the pingora Node binding",
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "keywords": [
    "pingora",
    "http",
    "server",
    "proxy",
    "napi",
    "rust"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unrs/pingora.git",
    "directory": "packages/http-server"
  },
  "dependencies": {
    "pingora": "workspace:^"
  },
  "engines": {
    "node": "^12.20.0 || ^14.18.0 || >=16.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
