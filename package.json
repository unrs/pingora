{
  "name": "pingora",
  "version": "0.0.1",
  "description": "Node.js binding for Cloudflare Pingora, built with napi-rs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unrs/pingora.git"
  },
  "keywords": [
    "pingora",
    "proxy",
    "reverse-proxy",
    "napi",
    "napi-rs",
    "rust"
  ],
  "engines": {
    "node": ">=10.16.0"
  },
  "napi": {
    "binaryName": "pingora",
    "packageName": "@pingora/binding",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ],
    "rootPublisher": "pnpm"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "test": "pnpm run build:debug && node --test __test__/index.test.mjs",
    "version": "node scripts/sync-versions.mjs && pnpm install --lockfile-only --ignore-scripts",
    "prepare": "lefthook install",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all -- --check",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "publish:platforms": "node scripts/publish-platforms.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "lefthook": "^2.2.2"
  },
  "optionalDependencies": {
    "@pingora/binding-darwin-arm64": "0.0.1",
    "@pingora/binding-darwin-x64": "0.0.1",
    "@pingora/binding-linux-arm64-gnu": "0.0.1",
    "@pingora/binding-linux-x64-gnu": "0.0.1"
  },
  "packageManager": "pnpm@12.14.0"
}
